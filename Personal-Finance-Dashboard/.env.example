# PUBLIC browser config: use the anon/publishable key, never a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Netlify server environment. Same anon key, authenticated requests retain user RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional; server only. Configured Redis failures fail closed for API requests.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local n8n only: an actual signed-in user's short-lived access token, never commit.
FINANCEFLOW_API_URL=http://localhost:8888/api
FINANCEFLOW_ACCESS_TOKEN=
