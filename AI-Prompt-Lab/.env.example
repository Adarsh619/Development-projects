# From your Supabase project's Connect dialog:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# From the OpenAI API dashboard. Server-only; never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Enable only when you want live requests and have API quota.
AI_CHAT_ENABLED=false

# Optional public Google OAuth client ID for Drive. Never add a client secret here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
